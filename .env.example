# --- LLM (see src/llm_client.py). Keys go in your environment / Codespaces secrets, never in git ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Per-agent overrides (optional). Prefixes: REASONING_, CRITIC_, QUERY_, EXTRACTION_, GRAPH_, RETRIEVAL_
# REASONING_PROVIDER=
# REASONING_MODEL=
# CRITIC_PROVIDER=
# CRITIC_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_FAKE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Local Neo4j (Docker Compose or Neo4j Desktop).
# Aura: replace URI with neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_GRAPH_ID=memory_graph

# Persistent Chroma, local all-MiniLM-L6-v2 embeddings.
# The embedding model downloads on first ingestion/search; no embedding API key.
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=memory_graph

# Local development; team hosting must enable OIDC and allowlist.
APP_ENV=local
APP_AUTH_REQUIRED=0
APP_ALLOWED_EMAILS=
APP_MAX_UPLOAD_FILES=10
APP_MAX_HISTORY_TURNS=20

# Validated retrieval/cost controls.
RETRIEVAL_TOP_K=5
RETRIEVAL_GRAPH_DEPTH=2
RETRIEVAL_MIN_SCORE=0.25
RETRIEVAL_MAX_GRAPH_FACTS=20
QUERY_MAX_RETRIES=2
PARSER_ENABLE_OCR=0
