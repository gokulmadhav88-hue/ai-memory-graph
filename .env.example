# --- LLM (see src/llm_client.py). Keys go in your environment / Codespaces secrets, never in git ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Per-agent overrides (optional). Prefixes: REASONING_, CRITIC_, QUERY_, EXTRACTION_, GRAPH_, RETRIEVAL_
# REASONING_PROVIDER=
# REASONING_MODEL=
# CRITIC_PROVIDER=
# CRITIC_MODEL=
OPENAI_API_KEY=your_api_key_here
ANTHROPIC_API_KEY=your_api_key_here
LLM_FAKE=0